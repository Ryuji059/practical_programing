<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 地図・記録・色分け画面 -->
    <LinearLayout
        android:id="@+id/mapLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 上部タイトルバー -->
        <TextView
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="自転車安全マップ"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:background="#43A047" />

        <!-- 地図エリア -->
        <FrameLayout
            android:id="@+id/mapArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <org.osmdroid.views.MapView
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 現在地ボタン -->
            <Button
                android:id="@+id/btnCurrentLocation"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:text="◎" />

            <!-- 色分けモード用パネル：地図の上に重ねる -->
            <LinearLayout
                android:id="@+id/roadEditPanel"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="道路種類を選択"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/radioRoadType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/radioSidewalk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="歩道通行可" />

                    <RadioButton
                        android:id="@+id/radioRoadway"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="車道推奨" />

                    <RadioButton
                        android:id="@+id/radioCaution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="注意区間" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnUndoRoadEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Undo" />

                    <Button
                        android:id="@+id/btnClearRoadEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="クリア" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnDeleteRoadEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="削除" />

                    <Button
                        android:id="@+id/btnSaveRoadEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="保存" />

                    <Button
                        android:id="@+id/btnFinishRoadEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="終了" />

                </LinearLayout>
            </LinearLayout>

        </FrameLayout>

        <!-- 通常・記録モード用ボタン -->
        <LinearLayout
            android:id="@+id/recordPanel"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="記録開始" />

                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="記録停止" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRoadEditMode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="色分け" />

                <Button
                    android:id="@+id/btnHistoryMode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="履歴" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- 履歴画面 -->
    <LinearLayout
        android:id="@+id/historyLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#FFFFFF">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#D65AC8">

            <TextView
                android:id="@+id/btnBackMapFromHistory"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="＜"
                android:textSize="24sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="走行履歴"
                android:textSize="22sp"
                android:textColor="#FFFFFF" />

        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp" />
        </ScrollView>

    </LinearLayout>
    <!--走行履歴表示用-->
    <LinearLayout
        android:id="@+id/historyDetailLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#D65AC8">

            <TextView
                android:id="@+id/btnBackHistory"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="＜"
                android:textSize="24sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="走行履歴"
                android:textSize="22sp"
                android:textColor="#FFFFFF" />

        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <org.osmdroid.views.MapView
                android:id="@+id/historyMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/routeDetailPanel"
                android:layout_width="match_parent"
                android:layout_height="450dp"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:translationY="390dp">

                <TextView
                    android:id="@+id/detailHandle"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="▲ 詳細"
                    android:textSize="22sp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/detailDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2026/06/25 14:03"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailRouteName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="走行ルート"
                            android:textSize="18sp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="【基本情報】"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/detailDistance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="走行距離: -"
                            android:textSize="18sp" />
                        <TextView
                            android:id="@+id/detailTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="走行時間: -"
                            android:textSize="18sp" />
                        <TextView
                            android:id="@+id/detailAverageSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="平均速度: -"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="【走行分析】"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/detailMovingTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="移動時間: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailStopTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="停止時間: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailStopCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="停止回数: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailLongestStopTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="最長停止時間: -"
                            android:textSize="18sp" />
                        <TextView
                            android:id="@+id/detailMovingAverageSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="移動中平均速度: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailMaxSectionSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="最高区間速度: -"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="【時間割合】"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/detailMovingRatio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="移動: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailStopRatio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="停止: -"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="【速度内訳】"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/detailSpeed0to5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0～5 km/h: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailSpeed5to10"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="5～10 km/h: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailSpeed10to15"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="10～15 km/h: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailSpeed15to20"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="15～20 km/h: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailSpeed20Over"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="20 km/h～: -"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="【参考】"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/detailMaxGpsSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="最高GPS速度: -"
                            android:textSize="18sp" />

                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

</FrameLayout>