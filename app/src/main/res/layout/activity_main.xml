<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 地図・記録・色分け画面 -->
    <LinearLayout
        android:id="@+id/mapLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 上部タイトルバー -->
        <RelativeLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#43A047">

            <!-- 左上のメニューボタン -->
            <TextView
                android:id="@+id/btnMainMenu"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:gravity="center"
                android:text="≡"
                android:textSize="30sp"
                android:textColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <!-- 中央タイトル -->
            <TextView
                android:id="@+id/titleBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="自転車安全マップ"
                android:textSize="22sp"
                android:textColor="#FFFFFF" />

        </RelativeLayout>

        <!-- 地図エリア -->
        <FrameLayout
            android:id="@+id/mapArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <org.osmdroid.views.MapView
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 現在地ボタン -->
            <Button
                android:id="@+id/btnCurrentLocation"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:text="◎" />

            <!-- 色分けモード用パネル：地図の上に重ねる -->
            <LinearLayout
                android:id="@+id/roadEditPanel"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="道路種類を選択"
                    android:textSize="16sp"
                    android:textColor="#000000"/>

                <RadioGroup
                    android:id="@+id/radioRoadType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/radioSidewalk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="歩道通行可"
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:buttonTint="#000000"/>

                    <RadioButton
                        android:id="@+id/radioRoadway"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="車道推奨"
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:buttonTint="#000000"/>

                    <RadioButton
                        android:id="@+id/radioCaution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="注意区間"
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:buttonTint="#000000"/>
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/selectedRoadPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:background="#EEEEEE"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btnEditRoadMemo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="コメント編集" />

                    <Button
                        android:id="@+id/btnDeleteRoadEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="削除" />

                    <Button
                        android:id="@+id/btnCancelRoadSelection"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="選択解除" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnUndoRoadEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Undo" />

                    <Button
                        android:id="@+id/btnClearRoadEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="クリア" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnSaveRoadEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="保存" />

                    <Button
                        android:id="@+id/btnFinishRoadEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="終了" />

                </LinearLayout>
            </LinearLayout>

        </FrameLayout>

        <!-- 通常・記録モード用ボタン -->
        <LinearLayout
            android:id="@+id/recordPanel"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="記録開始" />

                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="記録停止" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRoadEditMode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="色分け" />

                <Button
                    android:id="@+id/btnHistoryMode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="履歴" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- 履歴画面 -->
    <LinearLayout
        android:id="@+id/historyLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#FFFFFF">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#D65AC8">

            <TextView
                android:id="@+id/btnBackMapFromHistory"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="＜"
                android:textSize="24sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="走行履歴"
                android:textSize="22sp"
                android:textColor="#FFFFFF" />

        </RelativeLayout>

        <!-- 履歴のフィルター・並び替え -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#EEEEEE">

            <Spinner
                android:id="@+id/spinnerHistoryPeriod"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/spinnerHistorySort"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp" />
        </ScrollView>

    </LinearLayout>
    <!--走行履歴表示用-->
    <LinearLayout
        android:id="@+id/historyDetailLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#D65AC8">

            <TextView
                android:id="@+id/btnBackHistory"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="＜"
                android:textSize="24sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="走行履歴"
                android:textSize="22sp"
                android:textColor="#FFFFFF" />

        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <org.osmdroid.views.MapView
                android:id="@+id/historyMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnToggleSpeedColor"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:text="速度色 ON"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/routeDetailPanel"
                android:layout_width="match_parent"
                android:layout_height="450dp"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:translationY="390dp">

                <TextView
                    android:id="@+id/detailHandle"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="▲ 詳細"
                    android:textSize="22sp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/detailDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2026/06/25 14:03"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailRouteName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="走行ルート"
                            android:textSize="18sp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="【基本情報】"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/detailDistance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="走行距離: -"
                            android:textSize="18sp" />
                        <TextView
                            android:id="@+id/detailTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="走行時間: -"
                            android:textSize="18sp" />
                        <TextView
                            android:id="@+id/detailAverageSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="平均速度: -"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="【走行分析】"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/detailMovingTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="移動時間: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailStopTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="停止時間: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailStopCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="停止回数: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailLongestStopTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="最長停止時間: -"
                            android:textSize="18sp" />
                        <TextView
                            android:id="@+id/detailMovingAverageSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="移動中平均速度: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailMaxSectionSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="最高区間速度: -"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="【時間割合】"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/detailMovingRatio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="移動: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailStopRatio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="停止: -"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="【速度内訳】"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/detailSpeed0to5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0～5 km/h: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailSpeed5to10"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="5～10 km/h: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailSpeed10to15"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="10～15 km/h: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailSpeed15to20"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="15～20 km/h: -"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/detailSpeed20Over"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="20 km/h～: -"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="【参考】"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/detailMaxGpsSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="最高GPS速度: -"
                            android:textSize="18sp" />

                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

    <!-- 統計画面 -->
    <LinearLayout
        android:id="@+id/statisticsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#FFFFFF">

        <!-- 上部タイトルバー -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#5C6BC0">

            <TextView
                android:id="@+id/btnStatisticsMenu"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="≡"
                android:textSize="30sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="統計"
                android:textSize="22sp"
                android:textColor="#FFFFFF" />

        </RelativeLayout>

        <!-- 統計期間の選択欄 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#EEEEEE">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="表示する統計"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- 全体・年・月・週を選択 -->
                <Spinner
                    android:id="@+id/spinnerStatisticsType"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1" />

                <!-- 2026年、2026年7月、7/20～7/26などを選択 -->
                <Spinner
                    android:id="@+id/spinnerStatisticsPeriod"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/statSelectedPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="全期間"
                android:textSize="15sp"
                android:textColor="#333333" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/statDistanceChartTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="年ごとの走行距離"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginBottom="8dp" />

                <jp.ac.gifu_u.info.katsuya.prog.DistanceBarChartView
                    android:id="@+id/statDistanceChart"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:background="#FAFAFA" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#CCCCCC" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="【累計】"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/statTotalRideCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="総走行回数: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statTotalDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="総走行距離: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statTotalRideTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="総走行時間: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statTotalMovingTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="総移動時間: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statTotalStopTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="総停止時間: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statTotalStopCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="累計停止回数: -"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="【最高記録】"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/statMaxDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="最長1回走行距離: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statMaxRideTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="最長1回走行時間: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statMaxAverageSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="最高平均速度: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statMaxGpsSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="最高GPS速度: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statMaxMovingAverageSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="最高移動中平均速度: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statLongestStopTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="最長停止時間: -"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:text="【速度分布】"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statSpeed0to5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0～5 km/h: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statSpeed5to10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5～10 km/h: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statSpeed10to15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="10～15 km/h: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statSpeed15to20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="15～20 km/h: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statSpeed20to25"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="20～25 km/h: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statSpeed25to30"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="25～30 km/h: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statSpeed30Over"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="30 km/h以上: -"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:text="【1回の走行距離分布】"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statDistance0to5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0～5 km: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statDistance5to10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5～10 km: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statDistance10to20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="10～20 km: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statDistance20to50"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="20～50 km: -"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statDistance50Over"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="50 km以上: -"
                    android:textSize="18sp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- メンテナンス画面 -->
    <LinearLayout
        android:id="@+id/maintenanceLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#FFFFFF">

        <!-- 上部タイトルバー -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#00897B">

            <TextView
                android:id="@+id/btnMaintenanceMenu"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="≡"
                android:textSize="30sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="メンテナンス"
                android:textSize="22sp"
                android:textColor="#FFFFFF" />

        </RelativeLayout>

        <!-- 自作カレンダー -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:background="#FFFFFF">

            <!-- 前月・年月・次月 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnPreviousMonth"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:text="＜"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/textCalendarMonth"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="2026年7月"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />

                <Button
                    android:id="@+id/btnNextMonth"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:text="＞"
                    android:textSize="18sp" />

            </LinearLayout>

            <!-- 曜日 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="月"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="火"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="水"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="木"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="金"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="土"
                    android:textColor="#1565C0"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="日"
                    android:textColor="#C62828"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 7列×6行の日付 -->
            <GridLayout
                android:id="@+id/maintenanceCalendarGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="7"
                android:rowCount="6" />

            <!-- カレンダーの色の説明 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginEnd="8dp"
                    android:text="記録あり"
                    android:textColor="#000000"
                    android:background="#C8E6C9" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginEnd="8dp"
                    android:text="予定あり"
                    android:textColor="#000000"
                    android:background="#FFF9C4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="選択中"
                    android:textColor="#000000"
                    android:background="#BBDEFB" />

            </LinearLayout>

        </LinearLayout>
        <!-- 選択中の日付 -->
        <TextView
            android:id="@+id/maintenanceSelectedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:text="選択日: -"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:layout_marginBottom="8dp"
            android:text="【この日のメンテナンス】"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <!-- 選択日の記録一覧 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/maintenanceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" />

        </ScrollView>

        <!-- 追加ボタン -->
        <Button
            android:id="@+id/btnAddMaintenance"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="12dp"
            android:text="メンテナンス記録を追加" />

    </LinearLayout>

</FrameLayout>